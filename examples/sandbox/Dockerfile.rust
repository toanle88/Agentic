FROM rust:1.82.0-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Add project-specific system libraries, cargo tools, and provider CLIs here.
# RUN cargo install cargo-nextest --version 0.9.80
WORKDIR /workspace
