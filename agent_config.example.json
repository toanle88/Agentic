{
  "task_source": "github",
  "automation": {
    "auto_publish": false
  },
  "test_commands": [
    ["python", "-m", "unittest", "discover", "-s", "tests", "-q"]
  ],
  "slow_test_commands": [],
  "max_retries": 3,
  "ci_repair": {
    "max_attempts": 2,
    "poll_interval_seconds": 15,
    "poll_timeout_seconds": 900
  },
  "max_files": null,
  "test_timeout_seconds": null,
  "task_timeout_seconds": 1800,
  "system_prompt": null,
  "security_mode": "trusted",
  "permission_policy": {
    "developer": {
      "read_files": true, "search_files": true, "edit_files": true,
      "create_files": true, "git_read": true, "run_checks": true,
      "network": false, "allow_dangerous": false
    },
    "reviewer": {
      "read_files": true, "search_files": true, "git_read": true,
      "network": false
    }
  },
  "sandbox": {
    "enabled": false,
    "engine": "docker",
    "image": "agentic-runner:latest",
    "allow_network": false,
    "build_network": false
  },
  "developer": {
    "provider": "codex",
    "model": null,
    "reasoning_effort": null,
    "timeout_seconds": null
  },
  "reviewer": {
    "provider": "codex",
    "model": null,
    "reasoning_effort": null,
    "timeout_seconds": null
  }
}
