{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toanle88/Agentic/blob/main/agent_config.schema.json",
  "title": "Agentic target configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "task_source": { "enum": ["github", "local"] },
    "github_host": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$", "default": "github.com", "description": "GitHub CLI host for repository, issue, and publication operations" },
    "test_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    },
    "slow_test_commands": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "max_files": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
    "test_timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400, "default": 300 },
    "task_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 1800 },
    "workflow_mode": { "enum": ["quick", "standard", "strict"], "default": "standard", "description": "Workflow depth; quick skips only low-risk automatic investigation" },
    "system_prompt": { "type": ["string", "null"], "minLength": 1 },
    "security_mode": { "enum": ["trusted", "isolated"], "default": "trusted" },
    "permission_policy": { "$ref": "#/$defs/permissionPolicy" },
    "sandbox": { "$ref": "#/$defs/sandbox" },
    "developer": { "$ref": "#/$defs/developerAgent" },
    "reviewer": { "$ref": "#/$defs/reviewerAgent" },
    "agent": { "$ref": "#/$defs/developerAgent" }
  },
  "$defs": {
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "engine": { "enum": ["docker", "podman"], "default": "docker" },
        "image": { "type": "string", "minLength": 1 },
        "dockerfile": { "type": ["string", "null"], "minLength": 1, "description": "Repository-relative Dockerfile to build before use" },
        "build_context": { "type": "string", "minLength": 1, "default": ".", "description": "Repository-relative Docker build context" },
        "language": { "enum": ["python", "node", "go", "rust", "java", "dotnet", null] },
        "allow_network": { "type": "boolean", "default": false },
        "build_network": { "type": "boolean", "default": true, "description": "Allow repository Dockerfile builds to access the engine's default network" },
        "pass_env": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["codex", "gemini", "claude", "copilot", "openrouter"] },
        "host": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$", "description": "Copilot-only host for authentication and model access; passed as COPILOT_GH_HOST" },
        "model": { "type": ["string", "null"] },
        "reasoning_effort": { "type": ["string", "null"] },
        "timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 },
        "executable_path": { "type": ["string", "null"], "minLength": 1, "description": "Copilot executable path; use an image-visible path in isolated mode" },
        "auth": { "enum": ["native_cli", "api_key", "both"], "default": "native_cli", "description": "Authentication mode; api_key and both use api_key_env or the provider default" },
        "api_key_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "base_url": { "type": "string", "format": "uri" },
        "max_tool_turns": { "type": ["integer", "null"], "minimum": 1, "maximum": 200 },
        "command_timeout_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 },
        "allow_network": { "type": "boolean" },
        "json_mode": { "type": "boolean", "default": false },
        "permission_policy": { "$ref": "#/$defs/rolePermissions" }
      }
    },
    "developerAgent": {
      "allOf": [
        { "$ref": "#/$defs/agent" },
        { "properties": { "permission_policy": { "$ref": "#/$defs/developerPermissions" } } }
      ]
    },
    "reviewerAgent": {
      "allOf": [
        { "$ref": "#/$defs/agent" },
        { "properties": { "permission_policy": { "$ref": "#/$defs/reviewerPermissions" } } }
      ]
    },
    "permissionPolicy": {
      "type": "object",
      "properties": {
        "developer": { "$ref": "#/$defs/developerPermissions" },
        "reviewer": { "$ref": "#/$defs/reviewerPermissions" }
      },
      "additionalProperties": false
    },
    "developerPermissions": {
      "type": "object",
      "properties": {
        "read_files": { "type": "boolean", "default": true },
        "search_files": { "type": "boolean", "default": true },
        "edit_files": { "type": "boolean", "default": true },
        "create_files": { "type": "boolean", "default": true },
        "git_read": { "type": "boolean", "default": true },
        "run_checks": { "type": "boolean", "default": true },
        "network": { "type": "boolean", "default": false },
        "allow_dangerous": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "reviewerPermissions": {
      "type": "object",
      "properties": {
        "read_files": { "type": "boolean", "default": true },
        "search_files": { "type": "boolean", "default": true },
        "edit_files": { "const": false, "default": false },
        "create_files": { "const": false, "default": false },
        "git_read": { "type": "boolean", "default": true },
        "run_checks": { "const": false, "default": false },
        "network": { "type": "boolean", "default": false },
        "allow_dangerous": { "const": false, "default": false }
      },
      "additionalProperties": false
    },
    "rolePermissions": {
      "type": "object",
      "properties": {
        "read_files": { "type": "boolean" },
        "search_files": { "type": "boolean" },
        "edit_files": { "type": "boolean" },
        "create_files": { "type": "boolean" },
        "git_read": { "type": "boolean" },
        "run_checks": { "type": "boolean" },
        "network": { "type": "boolean" },
        "allow_dangerous": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
